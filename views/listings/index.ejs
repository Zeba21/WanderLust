<% layout("layouts/boilerplate") %>
 
  <style>
    #filters{
      display:flex;
      flex-wrap: wrap;

    }

    .filter {
      text-align: center;
      margin-right: 2.5rem;
      margin-top: 2rem;
      opacity: 0.7;
      text-decoration: none;
      color: inherit;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
      color: #fe424d;
      text-decoration: none;
  
    }

    .filter p {
      font-size: 0.8rem;
    }

  </style>

    <!-- for filters -->
     <div id="filters">

       <div class="filter">
         <a href="/listings" class="filter">
         <div><i class="fa-solid fa-fire"></i></div>
         <p>Trending</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Rooms" class="filter">
          <div><i class="fa-solid fa-bed"></i></div>
          <p>Rooms</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Iconic cities" class="filter">
         <div><i class="fa-solid fa-city"></i></div>
         <p>Iconic Cities</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Mountains" class="filter">
         <div><i class="fa-solid fa-mountain-city"></i></div>
         <p>Mountains</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Beaches" class="filter">
         <div><i class="fa-solid fa-umbrella-beach"></i></div>
         <p>Beaches</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Castles" class="filter">
         <div><i class="fa-brands fa-fort-awesome"></i></div>
         <p>Castles</p>
       </a>  
       </div>

       <div class="filter">
         <a href="/listings?category=Pools" class="filter">
           <div><i class="fa-solid fa-person-swimming"></i></div>
           <p>Amazing pools</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Camping" class="filter">
         <div><i class="fa-solid fa-campground"></i></div>
         <p>Camping</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Farms" class="filter">
         <div><i class="fa-solid fa-cow"></i></div>
         <p>Farms</p>
         </a>
       </div>

       <div class="filter">
        <a href="/listings?category=Arctic" class="filter">
         <div><i class="fa-regular fa-snowflake"></i></div>
         <p>Arctic</p>
         </a>
       </div>

     </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for( let listing of allListings ) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">

          <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;" />
            <!--style for same img size -->

            <div class="card-img-overlay">abc</div> <!-- overlay = writing on image-->
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= listing.title %>
                </b> <br>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
              </p>
            </div>
          </div>
        </a>
        <% } %>
    </div>
